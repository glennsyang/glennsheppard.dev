---
import { getEntry } from "astro:content";
import Title from "./Title.astro";
import Reveal from "./Reveal.astro";

const contact = await getEntry("contact", "main");

if (!contact) {
  throw new Error("Missing contact content entry");
}

const { cta, btn, email } = contact.data;
---

<section id="contact">
  <div class="container-x">
    <Title title="Contact" />
    <Reveal direction="up" delay={800}>
      <div class="contact-wrapper">
        <p class="contact-wrapper__text">{cta}</p>
        <a
          target="_blank"
          rel="noopener noreferrer"
          class="cta-btn cta-btn--resume"
          href={`mailto:${email}`}
        >
          {btn}
        </a>
      </div>
    </Reveal>
  </div>
</section>
