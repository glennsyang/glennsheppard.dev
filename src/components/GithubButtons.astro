---
// Static GitHub star/fork buttons using the official buttons.github.io script.
// The script is loaded once and turns anchors with class="github-button" into buttons.
---
<div class="flex justify-center gap-3 mt-4">
  <a
    class="github-button"
    href="https://github.com/glennsyang/glennsheppard.dev/fork"
    data-icon="octicon-repo-forked"
    data-size="large"
    data-show-count="true"
    aria-label="Fork glennsyang/glennsheppard.dev on GitHub"
  >
    Fork
  </a>
  <a
    class="github-button"
    href="https://github.com/glennsyang/glennsheppard.dev"
    data-icon="octicon-star"
    data-size="large"
    data-show-count="true"
    aria-label="Star glennsyang/glennsheppard.dev on GitHub"
  >
    Star
  </a>
</div>
<script is:inline async defer src="https://buttons.github.io/buttons.js"></script>
