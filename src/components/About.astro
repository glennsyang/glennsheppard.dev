---
import { Image } from "astro:assets";
import { getEntry } from "astro:content";
import Title from "./Title.astro";
import Reveal from "./Reveal.astro";

const about = await getEntry("about", "main");

if (!about) {
  throw new Error("Missing about content entry");
}

const { img, imgAlt, paragraphOne, paragraphTwo, paragraphThree, resume } =
  about.data;
---

<section id="about">
  <div class="container-x">
    <Title title="About Me" />
    <div class="about-wrapper grid grid-cols-1 md:grid-cols-2 gap-8">
      <div>
        <Reveal direction="up" delay={600}>
          <div class="about-wrapper__image">
            <Image
              src={img}
              alt={imgAlt}
              width={350}
              height={350}
              loading="eager"
            />
          </div>
        </Reveal>
      </div>
      <div>
        <Reveal direction="left" delay={1000}>
          <div class="about-wrapper__info">
            <p class="about-wrapper__info-text">{paragraphOne}</p>
            <p class="about-wrapper__info-text">{paragraphTwo}</p>
            <p class="about-wrapper__info-text">{paragraphThree}</p>
            {
              resume && (
                <span class="flex mt-3">
                  <a
                    target="_blank"
                    rel="noopener noreferrer"
                    class="cta-btn cta-btn--resume"
                    href={resume}
                  >
                    Resume
                  </a>
                </span>
              )
            }
          </div>
        </Reveal>
      </div>
    </div>
  </div>
</section>
