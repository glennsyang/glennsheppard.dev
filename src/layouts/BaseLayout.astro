---
import { getEntry } from "astro:content";
import "../styles/global.css";

const head = await getEntry("head", "site");

if (!head) {
  throw new Error("Missing head content entry");
}

const { title, lang, description } = head.data;
const measurementId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID;
const shouldLoadAnalytics = import.meta.env.PROD && Boolean(measurementId);
const analyticsConfig = `
  window.dataLayer = window.dataLayer || [];
  function gtag() {
    window.dataLayer.push(arguments);
  }
  gtag("js", new Date());
  gtag("config", ${JSON.stringify(measurementId)});
`;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="x-ua-compatible" content="ie=edge" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, shrink-to-fit=no"
    />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css?family=Montserrat:400,700&display=swap"
      rel="stylesheet"
    />
    {shouldLoadAnalytics && (
      <>
        <script
          async
          is:inline
          src={`https://www.googletagmanager.com/gtag/js?id=${measurementId}`}
        ></script>
        <script is:inline set:html={analyticsConfig}></script>
      </>
    )}
  </head>
  <body>
    <slot />
    <script>
      import "../scripts/reveal.ts";
    </script>
  </body>
</html>
