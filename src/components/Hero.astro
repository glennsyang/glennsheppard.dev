---
import Reveal from "./Reveal.astro";
import { getEntry } from "astro:content";

const hero = await getEntry("hero", "main");

if (!hero) {
  throw new Error("Missing hero content entry");
}

const { title, name, subtitle, cta } = hero.data;
---

<section id="hero" class="jumbotron">
  <div class="container-x">
    <Reveal direction="left" delay={500}>
      <h1 class="hero-title">
        {title}
        <span class="text-color-main">{name}</span>
        <br />
        {subtitle}
      </h1>
    </Reveal>
    <Reveal direction="left" delay={1000}>
      <p class="hero-cta">
        <a class="cta-btn cta-btn--hero" href="#about">{cta}</a>
      </p>
    </Reveal>
  </div>
</section>
